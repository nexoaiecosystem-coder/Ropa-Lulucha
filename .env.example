# Copiar a .env y completar con valores reales. No commitear .env.

# Cadena de conexión de la base Postgres (Neon / Vercel Postgres / etc).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secreto para firmar sesiones de NextAuth. Generar uno propio con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="reemplazar-con-un-secreto-generado"
